# Postgres. Generate a password with:
#   node -e "console.log(require('crypto').randomBytes(18).toString('base64url'))"
POSTGRES_PASSWORD="CHANGE_ME"
DATABASE_URL="postgresql://m8x:CHANGE_ME@localhost:5432/m8x?schema=public"

# 32-byte key, base64 encoded. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
M8X_ENCRYPTION_KEY="CHANGE_ME_base64_32_bytes"

# Public base URL, used to build webhook URLs shown in the UI
M8X_PUBLIC_URL="http://localhost:3000"

# Set to 1 only when TLS is terminated by a proxy that does not forward
# x-forwarded-proto. Otherwise the session cookie follows the request scheme.
# M8X_FORCE_SECURE_COOKIES=1

# Run the worker inside the web server instead of as its own container.
# Fewer moving parts, but deploying then kills any workflow that is mid-run.
# M8X_RUN_WORKER_IN_WEB=1

# Point the Telegram nodes at something other than Telegram's own servers,
# such as a local Bot API server or an egress proxy.
# M8X_TELEGRAM_API_BASE="https://api.telegram.org"

# Seed user (created by `npm run db:seed`)
M8X_SEED_EMAIL="admin@m8x.local"
M8X_SEED_PASSWORD="changeme"
