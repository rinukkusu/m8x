# Postgres
DATABASE_URL="postgresql://m8x:m8x@localhost:5432/m8x?schema=public"

# 32-byte key, base64 encoded. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
M8X_ENCRYPTION_KEY="CHANGE_ME_base64_32_bytes"

# Session cookie signing secret
M8X_SESSION_SECRET="CHANGE_ME_random_string"

# Public base URL, used to build webhook URLs shown in the UI
M8X_PUBLIC_URL="http://localhost:3000"

# Seed user (created by `npm run db:seed`)
M8X_SEED_EMAIL="admin@m8x.local"
M8X_SEED_PASSWORD="changeme"
