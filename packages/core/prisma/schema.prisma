generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Auth (deliberately minimal: single team, no orgs, no RBAC)
// ---------------------------------------------------------------------------

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String?
  passwordHash String
  createdAt    DateTime  @default(now())
  sessions     Session[]
}

model Session {
  // No cuid default on purpose: this id is the session cookie, so it is a
  // bearer credential and has to come from the CSPRNG. The application supplies
  // it, and leaving the default off means a caller that forgets cannot compile.
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Folders
//
// `path` is a materialised path of ancestor ids, e.g. "/cuid_a/cuid_b/".
// Listing a whole subtree is then `where path startsWith "<parent.path><id>/"`,
// which is one indexed query instead of a recursive CTE on every render.
// It must be rewritten for the subtree whenever a folder moves.
// ---------------------------------------------------------------------------

model Folder {
  id        String     @id @default(cuid())
  name      String
  parentId  String?
  parent    Folder?    @relation("FolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  Folder[]   @relation("FolderTree")
  path      String     @default("/")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  workflows Workflow[]

  @@unique([parentId, name])
  @@index([path])
}

// ---------------------------------------------------------------------------
// Workflows
// ---------------------------------------------------------------------------

model Workflow {
  id               String   @id @default(cuid())
  name             String
  folderId         String?
  folder           Folder?  @relation(fields: [folderId], references: [id], onDelete: SetNull)
  active           Boolean  @default(false)
  // Working copy of the graph. Saved runs point at a WorkflowVersion instead,
  // so history stays readable after the workflow is edited.
  graph            Json
  currentVersionId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  versions   WorkflowVersion[]
  executions Execution[]
  triggers   Trigger[]

  @@index([folderId])
  @@index([active])
}

model WorkflowVersion {
  id         String      @id @default(cuid())
  workflowId String
  workflow   Workflow    @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  version    Int
  graph      Json
  createdAt  DateTime    @default(now())
  executions Execution[]

  @@unique([workflowId, version])
  @@index([workflowId])
}

// ---------------------------------------------------------------------------
// Triggers
// ---------------------------------------------------------------------------

enum TriggerKind {
  webhook
  schedule
  telegram
  email
  datatable
}

model Trigger {
  id          String      @id @default(cuid())
  workflowId  String
  workflow    Workflow    @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  // Graph node id this trigger belongs to.
  nodeId      String
  kind        TriggerKind
  config      Json
  // Only set for kind = webhook. The path segment after /api/webhooks/.
  webhookPath String?     @unique
  enabled     Boolean     @default(true)

  // Only set for kind = schedule. The scheduler ticks once a minute and claims
  // every trigger whose nextRunAt has passed, so due times survive a restart
  // and a second worker cannot double-fire one.
  nextRunAt DateTime?
  lastRunAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workflowId, nodeId])
  @@index([workflowId])
  @@index([kind, enabled, nextRunAt])
}

// One row per bot, not per trigger.
//
// Telegram allows a single getUpdates call per token at a time, and the offset
// acknowledges updates for the whole bot rather than for one consumer. So the
// cursor and the lease belong to the credential, and every trigger using that
// credential is fed from the one poll. That is what lets several workflows
// share a bot instead of stealing each other's messages.
// One row per mailbox being watched, shared by every trigger pointing at it,
// for the same reason TelegramBot is shared by every trigger on one bot: the
// cursor belongs to the mailbox, not to the workflow reading it.
model MailFolder {
  // The Credential holding the IMAP login. Not a relation, matching TelegramBot:
  // deleting a credential a workflow still names should not fail.
  credentialId String
  folder       String

  // Highest UID already turned into executions. The next poll asks for what is
  // above it.
  lastUid     BigInt  @default(0)
  // UIDs are stable only while this is unchanged. When a server changes it,
  // every stored UID means something else, so the mailbox is resynced from its
  // current end rather than replayed from the start.
  uidValidity BigInt?

  // Held while one worker is mid-poll, so a second worker leaves it alone.
  leaseUntil   DateTime?
  leaseOwner   String?
  // Why the last poll failed, so a wrong password or a blocked port is
  // diagnosable without reading the worker log.
  lastError    String?
  lastPolledAt DateTime?
  updatedAt    DateTime  @updatedAt

  @@id([credentialId, folder])
}

model TelegramBot {
  // The Credential this bot's token lives in. Not a relation: a credential can
  // be deleted while a workflow still references it, and the poller should skip
  // that quietly rather than the delete failing.
  credentialId String    @id
  // The next update_id to ask Telegram for.
  offset       BigInt    @default(0)
  // Held while one worker is mid-poll, so a second worker leaves the bot alone.
  leaseUntil   DateTime?
  leaseOwner   String?
  // Why the last poll failed, so a revoked token is diagnosable.
  lastError    String?
  lastPolledAt DateTime?
  updatedAt    DateTime  @updatedAt
}

// ---------------------------------------------------------------------------
// Executions
//
// The failure columns are denormalised on purpose. The failures view filters
// and groups by them constantly, and digging into NodeRun for every row would
// make that page slow at exactly the volume where it becomes useful.
// ---------------------------------------------------------------------------

enum ExecutionStatus {
  queued
  running
  success
  failed
  cancelled
}

enum TriggerSource {
  manual
  webhook
  schedule
  telegram
  email
  datatable
  retry
  subworkflow
}

model Execution {
  id                String           @id @default(cuid())
  workflowId        String
  workflow          Workflow         @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  workflowVersionId String?
  workflowVersion   WorkflowVersion? @relation(fields: [workflowVersionId], references: [id], onDelete: SetNull)

  status  ExecutionStatus @default(queued)
  trigger TriggerSource

  // Items handed to the trigger node, e.g. the webhook request payload.
  input Json?

  queuedAt   DateTime  @default(now())
  startedAt  DateTime?
  finishedAt DateTime?
  durationMs Int?

  // Failure summary, mirrored from the NodeRun that threw.
  errorNodeId      String?
  errorNodeName    String?
  errorType        String?
  errorMessage     String?
  // Hash of (node type, error type, normalised message). Grouping by this is
  // what turns a wall of failures into a short list of distinct problems.
  errorFingerprint String?

  // Set when another workflow's Execute Workflow node started this run. Cascade
  // rather than SetNull: a child run means nothing without its parent, and
  // orphans would clutter the executions list forever.
  parentExecutionId String?
  parentExecution   Execution?  @relation("ExecutionParent", fields: [parentExecutionId], references: [id], onDelete: Cascade)
  children          Execution[] @relation("ExecutionParent")
  // The node in the parent graph that started it, so the parent's detail view
  // can link through.
  parentNodeId      String?

  // Set when this execution is a retry of another one.
  retryOfId String?
  retryOf   Execution?  @relation("ExecutionRetry", fields: [retryOfId], references: [id], onDelete: SetNull)
  retries   Execution[] @relation("ExecutionRetry")

  nodeRuns NodeRun[]
  binaries BinaryObject[]

  @@index([workflowId, queuedAt(sort: Desc)])
  @@index([status, queuedAt(sort: Desc)])
  @@index([errorFingerprint, queuedAt(sort: Desc)])
  @@index([queuedAt(sort: Desc)])
  @@index([parentExecutionId])
}

// ---------------------------------------------------------------------------
// Binary objects
//
// File bytes that travel with an item live here rather than inside it.
// Execution.input is the real payload, read back on every run and every retry,
// and NodeRun payloads are capped at 64 kB, so an attachment held inline would
// either bloat the database permanently or be truncated into uselessness.
// Items carry a `ref` to one of these rows and load the bytes on demand.
// ---------------------------------------------------------------------------

model BinaryObject {
  id String @id @default(cuid())

  // Nullable because the row is written before the execution that refers to it
  // exists: a poller stores the attachments, then seeds the run. Rows left
  // unclaimed by a run that never got queued are pruned by age.
  executionId String?
  execution   Execution? @relation(fields: [executionId], references: [id], onDelete: Cascade)

  mimeType String
  fileName String?
  size     Int
  bytes    Bytes

  createdAt DateTime @default(now())

  @@index([executionId])
  @@index([createdAt])
}

enum NodeRunStatus {
  running
  success
  failed
  skipped
}

model NodeRun {
  id          String    @id @default(cuid())
  executionId String
  execution   Execution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  nodeId    String
  nodeName  String
  nodeType  String
  status    NodeRunStatus
  // 1 for the first try. Each retry gets its own row.
  attempt   Int           @default(1)
  // Which pass of a Loop Over Items this row belongs to, 0 outside any loop.
  // A loop body emits one row per node per pass, all of them attempt 1.
  iteration Int           @default(0)
  // Order the runner reached this node in, for stable display.
  sequence  Int

  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  durationMs Int?

  // The actual items in and out. This is what makes the execution detail view
  // worth opening. Both are truncated past a size cap.
  input           Json?
  output          Json?
  inputTruncated  Boolean @default(false)
  outputTruncated Boolean @default(false)

  error Json?

  @@index([executionId, sequence])
  @@index([nodeType, status])
}

// ---------------------------------------------------------------------------
// Credentials
// ---------------------------------------------------------------------------

model Credential {
  id        String   @id @default(cuid())
  name      String   @unique
  type      String
  // AES-256-GCM ciphertext. Only ever decrypted inside the worker.
  data      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
}

// ---------------------------------------------------------------------------
// Datatables
//
// Somewhere for a workflow to keep state between runs. One row per record with
// the record in a `Json` column, rather than one row per field: an eight-column
// table would otherwise be eight rows to read back and a self-join to filter on
// two fields, and every value would be text, so `total > 100` could not use an
// index. The flexibility that shape is reached for is already here, because
// `columns` is metadata and the rows are schemaless underneath it.
//
// See docs/datatables.md.
// ---------------------------------------------------------------------------

model Datatable {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?

  // DatatableColumn[]: { key, name, type, required?, unique?, default? }.
  // Metadata only, so adding or removing a column rewrites no rows: a row that
  // predates a column simply lacks the key, and reads fill in its default.
  columns Json @default("[]")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rows DatatableRow[]
}

model DatatableRow {
  id          String    @id @default(cuid())
  datatableId String
  datatable   Datatable @relation(fields: [datatableId], references: [id], onDelete: Cascade)

  // Exactly an Item.json, so what a node wrote is what a node reads, with no
  // mapping layer in between. Capped at 64 kB of serialised JSON on write.
  data Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([datatableId, createdAt(sort: Desc)])
  // Containment and key lookups on arbitrary columns, which is what every
  // filter compiles to. jsonb_path_ops rather than the default: the filters
  // here only ever ask about a key's value, never whether a key exists, and the
  // smaller index is the one that stays fast as a table grows.
  @@index([data(ops: JsonbPathOps)], type: Gin)
}
